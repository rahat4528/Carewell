# Pharmacy Management System Environment Configuration
PORT=4004
NODE_ENV=development

# Database (PostgreSQL for Docker, SQLite for self-contained automated testing)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL URL:
# DATABASE_URL="postgresql://pharmacy_user:pharmacy_secure_pass@localhost:5434/carewell_pharmacy_db?schema=public"

# Redis Cache & Concurrency Lock
REDIS_URL="redis://localhost:6384"

# JWT Authentication Secret
JWT_SECRET="carewell-pharmacy-jwt-secret-key-at-least-32-chars-long"

# Audit Log Hash Chain Secret Salt
AUDIT_SALT="carewell-pharmacy-audit-tamper-evident-salt-2026"
