datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String
  role         String          @default("PATIENT") // PATIENT, DOCTOR, ADMIN
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  patient      PatientProfile?
  doctor       DoctorProfile?
  auditLogs    AuditLog[]
}

model PatientProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  dateOfBirth    String?       // YYYY-MM-DD
  gender         String?
  timezone       String        @default("America/New_York")
  createdAt      DateTime      @default(now())

  appointments   Appointment[]
  waitlistEntries WaitlistEntry[]
  reviews        Review[]
}

model DoctorProfile {
  id                 String                    @id @default(uuid())
  userId             String                    @unique
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialtyId        String
  specialty          Specialty                 @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  licenseNumber      String
  consultationFee    Float                     @default(150.0)
  bio                String?
  verificationStatus String                    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED
  rating             Float                     @default(5.0)
  ratingCount        Int                       @default(0)
  createdAt          DateTime                  @default(now())

  affiliations       DoctorClinicAffiliation[]
  schedules          DoctorSchedule[]
  slots              AvailabilitySlot[]
  appointments       Appointment[]
  waitlistEntries    WaitlistEntry[]
  reviews            Review[]
}

model Specialty {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  doctors     DoctorProfile[]
}

model Clinic {
  id           String                    @id @default(uuid())
  name         String
  address      String
  timezone     String                    @default("America/New_York") // IANA Timezone
  phone        String?
  createdAt    DateTime                  @default(now())

  affiliations DoctorClinicAffiliation[]
  schedules    DoctorSchedule[]
  slots        AvailabilitySlot[]
  appointments Appointment[]
}

model DoctorClinicAffiliation {
  id       String        @id @default(uuid())
  doctorId String
  doctor   DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId String
  clinic   Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([doctorId, clinicId])
}

model DoctorSchedule {
  id                  String        @id @default(uuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId            String
  clinic              Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dayOfWeek           Int           // 1 (Monday) to 7 (Sunday)
  startTime           String        // "09:00"
  endTime             String        // "17:00"
  slotDurationMinutes Int           @default(30)
  bufferMinutes       Int           @default(5)
  isActive            Boolean       @default(true)
}

model AvailabilitySlot {
  id         String        @id @default(uuid())
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId   String
  clinic     Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  startTime  DateTime      // UTC
  endTime    DateTime      // UTC
  isBooked   Boolean       @default(false)
  heldUntil  DateTime?     // Temporary hold expiry
  createdAt  DateTime      @default(now())

  appointment Appointment?

  @@unique([doctorId, startTime, clinicId])
}

model Appointment {
  id                 String                     @id @default(uuid())
  patientId          String
  patient            PatientProfile             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId           String
  doctor             DoctorProfile              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  clinicId           String
  clinic             Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  slotId             String                     @unique
  slot               AvailabilitySlot           @relation(fields: [slotId], references: [id], onDelete: Restrict)
  status             String                     @default("CONFIRMED") // REQUESTED, CONFIRMED, CHECKED_IN, COMPLETED, CANCELLED_BY_PATIENT, CANCELLED_BY_DOCTOR, NO_SHOW, RESCHEDULED
  reason             String?
  cancellationReason String?
  videoMeetingUrl    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  history            AppointmentStatusHistory[]
  note               ConsultationNote?
  review             Review?
}

model AppointmentStatusHistory {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        String
  actorId       String?
  note          String?
  timestamp     DateTime    @default(now())
}

model ConsultationNote {
  id               String      @id @default(uuid())
  appointmentId    String      @unique
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  encryptedContent String      // AES-256-GCM ciphertext
  iv               String      // Initialization vector
  authTag          String      // Authentication tag
  authorDoctorId   String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Review {
  id            String         @id @default(uuid())
  appointmentId String         @unique
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  rating        Int            // 1 to 5
  comment       String?
  createdAt     DateTime       @default(now())
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinicId       String
  targetDate     String         // YYYY-MM-DD
  status         String         @default("WAITING") // WAITING, OFFERED, CLAIMED, EXPIRED
  offerExpiresAt DateTime?
  createdAt      DateTime       @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // NOTE_READ, APPOINTMENT_BOOK, APPOINTMENT_CANCEL, DOCTOR_VERIFY
  resource     String
  details      String?
  timestamp    DateTime @default(now())
  previousHash String?
  hash         String
}
