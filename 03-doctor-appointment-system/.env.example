# ==============================================================================
# Carewell Doctor Appointment System - Environment Configuration
# ==============================================================================

# Application
NODE_ENV=development
PORT=4003
FRONTEND_PORT=3003
FRONTEND_URL=http://localhost:3003
API_PREFIX=/api/v1

# PostgreSQL Database (carewell_appointments_db)
DATABASE_URL=postgresql://appointments_user:appointments_secure_pass_2026@localhost:5433/carewell_appointments_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6383

# Security & Cryptography (32-byte hex key for AES-256-GCM clinical notes encryption)
JWT_SECRET=super_secret_jwt_key_appointments_2026_dev_only
JWT_EXPIRATION=7d
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Scheduling Policy
CANCELLATION_MIN_NOTICE_HOURS=24
SLOT_HOLD_DURATION_MINUTES=10
TELECONSULTATION_WINDOW_BEFORE_MINUTES=15
TELECONSULTATION_WINDOW_AFTER_MINUTES=60
