# ==============================================================================
# Carewell Meal Planner App - Environment Configuration
# ==============================================================================

# Application
NODE_ENV=development
PORT=4002
FRONTEND_PORT=3002
FRONTEND_URL=http://localhost:3002
API_PREFIX=/api/v1

# PostgreSQL Database (carewell_meal_planner_db)
DATABASE_URL=postgresql://meal_user:meal_secure_pass_2026@localhost:5432/carewell_meal_planner_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6382

# Security & Cryptography
JWT_SECRET=super_secret_jwt_key_meal_planner_2026_dev_only
JWT_EXPIRATION=7d
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SSRF Protection
SSRF_TIMEOUT_MS=5000
SSRF_MAX_RESPONSE_SIZE_BYTES=2097152
