datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  role         String            @default("USER")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  memberships  HouseholdMember[]
  auditLogs    AuditLog[]
}

model Household {
  id           String            @id @default(uuid())
  name         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  members      HouseholdMember[]
  recipes      Recipe[]
  mealPlans    MealPlan[]
  shoppingLists ShoppingList[]
  pantryItems  PantryItem[]
  exclusions   DietaryExclusion[]
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // OWNER, MEMBER, VIEWER
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
}

model Recipe {
  id              String             @id @default(uuid())
  householdId     String
  household       Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  prepTimeMinutes Int                @default(15)
  cookTimeMinutes Int                @default(20)
  totalTimeMinutes Int               @default(35)
  baseServings    Int                @default(4)
  cuisine         String             @default("General")
  mealCategory    String             @default("DINNER") // BREAKFAST, LUNCH, DINNER, SNACK
  dietaryTags     String             @default("[]") // JSON string of tags e.g. ["GLUTEN_FREE", "VEGAN"]
  sourceUrl       String?
  isCustom        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  ingredients     RecipeIngredient[]
  cookingSteps    CookingStep[]
  plannedMeals    PlannedMeal[]
}

model RecipeIngredient {
  id         String   @id @default(uuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float    @default(1.0)
  unit       String   @default("count") // g, kg, ml, l, cup, tbsp, tsp, count
  dimension  String   @default("COUNT") // MASS, VOLUME, COUNT, OTHER
  isScalable Boolean  @default(true)
  notes      String?
  aisle      String   @default("PANTRY_BAKING")
}

model CookingStep {
  id           String   @id @default(uuid())
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber   Int
  instruction  String
  timerMinutes Int?
}

model MealPlan {
  id            String        @id @default(uuid())
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String
  weekStartDate String        // YYYY-MM-DD (Monday)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  plannedMeals  PlannedMeal[]
}

model PlannedMeal {
  id             String    @id @default(uuid())
  mealPlanId     String
  mealPlan       MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId       String
  recipe         Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  date           String    // YYYY-MM-DD
  mealSlot       String    @default("DINNER") // BREAKFAST, LUNCH, DINNER, SNACK
  targetServings Int       @default(4)
  notes          String?
}

model ShoppingList {
  id            String             @id @default(uuid())
  householdId   String
  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name          String
  weekStartDate String             // YYYY-MM-DD
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items         ShoppingListItem[]
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  name           String
  quantity       Float
  unit           String
  dimension      String       @default("COUNT")
  aisle          String       @default("PANTRY_BAKING")
  checked        Boolean      @default(false)
  pantryDeducted Float        @default(0.0)
  notes          String?
}

model PantryItem {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  quantity    Float
  unit        String
  dimension   String    @default("COUNT") // MASS, VOLUME, COUNT
  location    String    @default("PANTRY") // PANTRY, REFRIGERATOR, FREEZER
  expiryDate  String    // YYYY-MM-DD
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FoodComposition {
  id                   String @id @default(uuid())
  name                 String @unique
  caloriesPer100g      Float
  proteinPer100g       Float
  carbsPer100g         Float
  fatPer100g           Float
  fiberPer100g         Float
  referenceServingGrams Float @default(100.0)
  source               String @default("OPEN_COMPOSITION_DATASET_V1")
}

model DietaryExclusion {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tag         String    // GLUTEN_FREE, VEGAN, VEGETARIAN, DAIRY_FREE, NUT_FREE, SHELLFISH_FREE
  notes       String?
}

model SubstitutionRule {
  id                  String @id @default(uuid())
  originalIngredient String
  substituteIngredient String
  ratio               Float  @default(1.0)
  notes               String
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  resource     String
  details      String?
  timestamp    DateTime @default(now())
  previousHash String?
  hash         String
}
