# ==============================================================================
# Carewell Fitness Tracker - Environment Configuration
# ==============================================================================

# Application
NODE_ENV=development
PORT=4001
FRONTEND_PORT=3001
FRONTEND_URL=http://localhost:3001
API_PREFIX=/api/v1

# PostgreSQL Database (carewell_fitness_db)
DATABASE_URL=postgresql://fitness_user:fitness_secure_pass_2026@localhost:5431/carewell_fitness_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6381

# Security & Cryptography (Generate secure 32-byte hex for production)
JWT_SECRET=super_secret_jwt_key_fitness_tracker_2026_dev_only
JWT_EXPIRATION=7d
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Device Integration (Optional Wearable Sync - Mocked Fixture Available in Tests)
ENABLE_FIXTURE_DEVICE_SYNC=true
