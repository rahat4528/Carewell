# Hospital Management System Environment Configuration
PORT=4005
NODE_ENV=development

# Database (PostgreSQL for Docker, SQLite for self-contained automated testing)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL URL:
# DATABASE_URL="postgresql://hospital_user:hospital_secure_pass@localhost:5435/carewell_hospital_db?schema=public"

# Redis Cache & Concurrency Lock
REDIS_URL="redis://localhost:6385"

# JWT Authentication Secret
JWT_SECRET="carewell-hospital-jwt-secret-key-at-least-32-chars-long"

# AES-256-GCM Note Encryption Key (64-char hex)
NOTE_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Audit Log Hash Chain Secret Salt
AUDIT_SALT="carewell-hospital-audit-tamper-evident-salt-2026"
